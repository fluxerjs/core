{
  "name": "fluxer-core-monorepo",
  "version": "2.0.3",
  "private": true,
  "license": "Apache-2.0",
  "description": "@fluxerjs SDK monorepo",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:esm": "node scripts/test-esm-imports.mjs",
    "test:cjs": "node scripts/test-cjs-require.mjs",
    "test:load": "pnpm run test:esm && pnpm run test:cjs && pnpm run test:exports",
    "test:exports": "node scripts/test-package-exports.mjs",
    "test:smoke": "node scripts/test-smoke.mjs",
    "test:bot": "node scripts/test-bot-login.mjs",
    "test:all": "pnpm run build && pnpm exec vitest run && pnpm run test:load && pnpm run test:smoke",
    "test:report": "pnpm run build && pnpm exec vitest run --reporter json --outputFile.json=test-results/results.json",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test:coverage": "vitest run --coverage",
    "clean": "turbo run clean",
    "generate:types": "pnpm exec tsx scripts/generate-types.ts",
    "openapi:update": "pnpm exec tsx scripts/openapi/update.ts",
    "openapi:verify": "pnpm exec tsx scripts/openapi/verify.ts",
    "openapi:generate": "pnpm exec tsx scripts/openapi/generate.ts",
    "openapi:coverage": "pnpm exec tsx scripts/openapi/coverage.ts",
    "check:boundaries": "pnpm exec tsx scripts/check-package-boundaries.ts",
    "check:exports": "pnpm exec tsx scripts/api-surface/check.ts",
    "snapshot:exports": "pnpm exec tsx scripts/api-surface/snapshot.ts",
    "typecheck:packages": "pnpm exec tsc -b packages/types packages/util packages/collection packages/rest packages/ws packages/builders packages/fluxer-core packages/voice --pretty false",
    "typecheck:tests": "pnpm exec tsc -p tsconfig.tests.json --pretty false",
    "typecheck": "pnpm run typecheck:packages && pnpm run typecheck:tests",
    "gate:pre-merge": "pnpm run format:check && pnpm run lint && pnpm run openapi:verify && pnpm run check:boundaries && pnpm run generate:types && pnpm run typecheck && pnpm run test:all",
    "generate:emoji": "pnpm exec tsx scripts/generate-emoji-shortcodes.ts",
    "generate:docs": "pnpm exec tsx scripts/generate-docs.ts",
    "docs:generate": "turbo run generate:docs",
    "docs:dev": "pnpm --filter @fluxerjs/docs dev",
    "docs:build": "turbo run build --filter=@fluxerjs/docs",
    "docs:preview": "pnpm --filter @fluxerjs/docs start",
    "publish:packages": "node scripts/publish-ordered.js",
    "publish:packages:all": "pnpm run build && pnpm -r publish --no-git-checks --filter '!./examples'"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@fluxerjs/builders": "workspace:*",
    "@fluxerjs/collection": "workspace:*",
    "@fluxerjs/core": "workspace:*",
    "@fluxerjs/docgen": "workspace:*",
    "@fluxerjs/rest": "workspace:*",
    "@fluxerjs/types": "workspace:*",
    "@fluxerjs/util": "workspace:*",
    "@fluxerjs/voice": "workspace:*",
    "@fluxerjs/ws": "workspace:*",
    "@vitest/coverage-v8": "^4.1.0",
    "lint-staged": "^16.2.7",
    "tsx": "^4.19.0",
    "turbo": "^2.9.14",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
