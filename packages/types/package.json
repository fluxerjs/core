{
  "name": "@fluxerjs/types",
  "publishConfig": {
    "access": "public"
  },
  "version": "2.0.0",
  "description": "TypeScript types for the Fluxer API",
  "repository": {
    "type": "git",
    "url": "https://github.com/fluxerjs/core.git",
    "directory": "packages/types"
  },
  "bugs": "https://github.com/fluxerjs/core/issues",
  "homepage": "https://fluxerjs.blstmo.com",
  "keywords": [
    "fluxer",
    "types",
    "api"
  ],
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "import": "./dist/routes.mjs",
      "require": "./dist/routes.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
