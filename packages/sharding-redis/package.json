{
  "name": "@fluxerjs/sharding-redis",
  "publishConfig": {
    "access": "public"
  },
  "version": "3.0.0",
  "description": "Redis-backed cluster coordinator, broker, and session store for @fluxerjs/sharding",
  "repository": {
    "type": "git",
    "url": "https://github.com/fluxerjs/core.git",
    "directory": "packages/sharding-redis"
  },
  "bugs": "https://github.com/fluxerjs/core/issues",
  "homepage": "https://fluxer.js.org",
  "keywords": [
    "fluxer",
    "sharding",
    "redis",
    "cluster"
  ],
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@fluxerjs/sharding": "workspace:*",
    "@fluxerjs/ws": "workspace:*"
  },
  "peerDependencies": {
    "redis": "^4.7.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "redis": "^4.7.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
