{
  "name": "@fluxerjs/core",
  "publishConfig": {
    "access": "public"
  },
  "version": "2.2.0",
  "description": "A fully-featured SDK for Fluxer bots",
  "repository": {
    "type": "git",
    "url": "https://github.com/fluxerjs/core.git",
    "directory": "packages/fluxer-core"
  },
  "bugs": "https://github.com/fluxerjs/core/issues",
  "homepage": "https://fluxerjs.blstmo.com",
  "keywords": [
    "fluxer",
    "discord",
    "sdk",
    "bot",
    "api"
  ],
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.mts",
        "default": "./dist/client.mjs"
      },
      "require": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/errors.d.mts",
        "default": "./dist/errors.mjs"
      },
      "require": {
        "types": "./dist/errors.d.ts",
        "default": "./dist/errors.js"
      }
    },
    "./message": {
      "import": {
        "types": "./dist/message.d.mts",
        "default": "./dist/message.mjs"
      },
      "require": {
        "types": "./dist/message.d.ts",
        "default": "./dist/message.js"
      }
    },
    "./cluster": {
      "import": {
        "types": "./dist/cluster.d.mts",
        "default": "./dist/cluster.mjs"
      },
      "require": {
        "types": "./dist/cluster.d.ts",
        "default": "./dist/cluster.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fluxerjs/rest": "workspace:*",
    "@fluxerjs/ws": "workspace:*",
    "@fluxerjs/builders": "workspace:*",
    "@fluxerjs/collection": "workspace:*",
    "@fluxerjs/util": "workspace:*",
    "@fluxerjs/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
