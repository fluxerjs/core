{
  "name": "@fluxerjs/rest",
  "publishConfig": {
    "access": "public"
  },
  "version": "2.2.0",
  "description": "REST client for the Fluxer API",
  "repository": {
    "type": "git",
    "url": "https://github.com/fluxerjs/core.git",
    "directory": "packages/rest"
  },
  "bugs": "https://github.com/fluxerjs/core/issues",
  "homepage": "https://fluxe.js.org",
  "keywords": [
    "fluxer",
    "api",
    "rest",
    "sdk",
    "bot"
  ],
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./request-manager": {
      "import": {
        "types": "./dist/request-manager.d.mts",
        "default": "./dist/request-manager.mjs"
      },
      "require": {
        "types": "./dist/request-manager.d.ts",
        "default": "./dist/request-manager.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@fluxerjs/types": "workspace:*",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
