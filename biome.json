{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/vendor",
      "!**/dist",
      "!**/coverage",
      "!**/node_modules",
      "!**/test-fixtures",
      "!**/*.generated.ts",
      "!**/_generated",
      "!**/apps/docs/.next",
      "!**/*.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": true
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "useImportType": "error",
        "noNonNullAssertion": "off",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["PascalCase"],
            "strictCase": false
          }
        }
      },
      "complexity": {
        "noForEach": "off",
        "noThisInStatic": "off",
        "noStaticOnlyClass": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/index.ts",
        "**/index.tsx",
        "**/index.js",
        "**/*.d.ts",
        "**/*.generated.ts",
        "**/*.config.ts",
        "**/*.config.js",
        "**/*.config.mjs",
        "**/*.config.cjs",
        ".changeset/**",
        "turbo.json",
        "pnpm-workspace.yaml"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/docs/app/**",
        "apps/docs/lib/**",
        "apps/docs/data/**",
        "apps/docs/components/ui/**",
        "apps/docs/components/mdx.tsx",
        "apps/docs/components/mdx-pre.tsx",
        "apps/docs/**/*.css"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          },
          "a11y": {
            "noSvgWithoutTitle": "off",
            "useSemanticElements": "off",
            "useKeyWithClickEvents": "off"
          },
          "suspicious": {
            "noAssignInExpressions": "off",
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/docs/components/**"],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "off"
          },
          "a11y": {
            "noSvgWithoutTitle": "off",
            "useSemanticElements": "off"
          },
          "suspicious": {
            "noAssignInExpressions": "off",
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": [
        "scripts/**",
        "apps/docs/scripts/**",
        "examples/**",
        "benchmarks/**",
        "local/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ]
}
